{
  "manifest_version": 3,
  "name": "Isolate",
  "version": "2.0.0",
  "description": "Vocal / BGM splitter for YouTube & YT Music. Instant center-channel mode plus optional AI (Demucs) stem separation.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Isolate"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://music.youtube.com/*",
    "https://isolate443.duckdns.org/*"
  ]
}
